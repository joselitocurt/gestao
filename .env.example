# Copie este arquivo para .env e ajuste os valores.

# Porta da API (em produção, também serve o site)
PORT=3001

# Endereço público do sistema — usado nos links de convite e de redefinição de senha
APP_URL=http://localhost:5173

# Pasta onde ficam o banco SQLite e os comprovantes enviados
DATA_DIR=data

# Segredo para assinar logins e links de comprovante.
# Se ficar vazio, um segredo é gerado e guardado em DATA_DIR/.secret
JWT_SECRET=

# Primeiro administrador (criado só quando o banco ainda não tem usuários)
ADMIN_EMAIL=
ADMIN_PASSWORD=
ADMIN_NOME=

# E-mail (convites e "Esqueci a senha"). Sem SMTP, os links aparecem no log do servidor.
SMTP_HOST=
SMTP_PORT=587
SMTP_SECURE=false
SMTP_USER=
SMTP_PASS=
SMTP_FROM=
